cmake_minimum_required(VERSION 3.16)
project(eb_predict_row CXX)
set(CMAKE_CXX_STANDARD 20)

set(CMAKE_PREFIX_PATH "/opt/view/lib/everybeam")
set(AOCOMMON_INCLUDE_DIR "" CACHE PATH "Path to directory containing aocommon headers")

find_package(EveryBeam CONFIG REQUIRED)

add_executable(eb_predict_row eb_predict_row.cc)

target_include_directories(eb_predict_row PRIVATE /opt/view/include)
if(AOCOMMON_INCLUDE_DIR)
  target_include_directories(eb_predict_row PRIVATE "${AOCOMMON_INCLUDE_DIR}")
endif()

target_link_directories(eb_predict_row PRIVATE /opt/view/lib)
target_link_libraries(eb_predict_row PRIVATE EveryBeam::everybeam)
